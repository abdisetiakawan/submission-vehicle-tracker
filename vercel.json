{
  "version": 2,
  "builds": [
    {
      "src": "vehicle-tracker-client/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "vehicle-tracker-server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
