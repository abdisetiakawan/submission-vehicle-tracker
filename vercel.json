{
  "version": 2,
  "builds": [
    { "src": "vehicle-tracker-client/package.json", "use": "@vercel/next" },
    { "src": "vehicle-tracker-server/src/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/vehicle-tracker-server/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/vehicle-tracker-client/$1"
    }
  ]
}
